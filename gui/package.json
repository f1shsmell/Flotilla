{
  "name": "flotilla-gui",
  "private": true,
  "version": "0.0.0-dev",
  "description": "Flotilla desktop client",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && vite build",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "bundle:binaries": "node scripts/bundle-binaries.mjs",
    "dist": "pnpm build && pnpm bundle:binaries && electron-builder --win --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.flotilla.app",
    "productName": "Flotilla",
    "copyright": "MIT",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Flotilla-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Flotilla",
      "deleteAppDataOnUninstall": false
    }
  }
}
