{
  "name": "flotilla-gui",
  "private": true,
  "version": "0.1.0",
  "description": "Flotilla desktop client",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && vite build",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "bundle:binaries": "node scripts/bundle-binaries.mjs",
    "dist": "pnpm build && node scripts/make-icons.mjs && node scripts/dist.mjs stable",
    "dist:preview": "pnpm build && node scripts/make-icons.mjs && node scripts/dist.mjs preview"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": {
    "name": "f1shsmell"
  }
}
