# Rust
/target/
**/*.rs.bk

# Node / GUI
node_modules/
gui/dist/
gui/.vite/

# Electron builder output
gui/out/
gui/release/
gui/resources/bin/

# Dev isolation homes and local state
.flt-home/
*.local.md

# Secrets and credentials — never commit
.env
.env.*
*.pem
*.p12

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
# Local smoke builds kept beside the daemon for offscreen runs
/flt-daemon.exe
/flt-session-host.exe
/flt-fake-acp-agent.exe
/flt-replay-agent.exe
*.exe~

# Third-party notices are generated at release time from the module graph and
# the gui's node graph; the output depends on what this machine has fetched, so
# a committed copy drifts from the one CI produces. See scripts/third-party-notices.sh.
/THIRD-PARTY-NOTICES.md
